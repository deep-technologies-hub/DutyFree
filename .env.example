# ═══════════════════════════════════════════════════════════════════
#  Copier en .env (jamais commité).  Valeurs prêtes pour un test LOCAL ;
#  les lignes marquées [PROD] sont à changer avant la mise en ligne.
# ═══════════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────────
POSTGRES_DB=dutyfree
POSTGRES_USER=postgres
# [PROD] mot de passe fort
POSTGRES_PASSWORD=local-dev-password

# ── Django ──────────────────────────────────────────────────────────
DEBUG=False
# [PROD] générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=local-dev-only-change-me-0123456789abcdefghijklmnop
# [PROD] app.mondomaine.com,caisse.mondomaine.com,stock.mondomaine.com
ALLOWED_HOSTS=localhost,127.0.0.1
# [PROD] https://app.mondomaine.com,https://caisse.mondomaine.com,https://stock.mondomaine.com (idem CSRF)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:81,http://localhost:82
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:81,http://localhost:82
# Forcé à True par docker-compose.prod.yml
USE_HTTPS=False
# Forcé à 2 par docker-compose.prod.yml (Caddy + nginx)
NUM_PROXIES=1
# [PROD] chemin discret, ex. gestion-x7k2/
ADMIN_URL=admin/

# ── URLs publiques (liens des emails, retours de paiement) ──────────
# [PROD] https://app.mondomaine.com (PUBLIC_URL et FRONTEND_URL),
#        https://caisse.mondomaine.com, https://stock.mondomaine.com
PUBLIC_URL=http://localhost
FRONTEND_URL=http://localhost
CAISSE_URL=http://localhost:81
STOCK_URL=http://localhost:82

# ── SaaS ────────────────────────────────────────────────────────────
SAAS_NOM=Duty Free Manager
SAAS_TRIAL_DAYS=14
SAAS_GRACE_DAYS=5
SAAS_RAPPEL_JOURS=7
SAAS_PAYMENT_INSTRUCTIONS=Vous pouvez aussi régler par virement en indiquant le numéro de facture.

# ── Paiement en ligne ───────────────────────────────────────────────
# Local : simulateur (forcé par docker-compose.override.yml)
# [PROD] PAYMENT_PROVIDER=cinetpay + clés du compte marchand (https://cinetpay.com)
PAYMENT_PROVIDER=cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Simulateur (encaisse sans argent réel) : désactivé par défaut hors DEBUG. Ne jamais l'activer en production.
# PAYMENT_SIMULATEUR_AUTORISE=False

# ── Connexion ───────────────────────────────────────────────────────
# Verrouillage d'un compte après N échecs (protège les PIN de caisse)
LOGIN_MAX_ECHECS=8
LOGIN_VERROU_MINUTES=15

# ── Email ───────────────────────────────────────────────────────────
# Local : Mailpit (forcé par docker-compose.override.yml)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@mondomaine.com

# ── Production HTTPS (docker-compose.prod.yml) ──────────────────────
# [PROD] domaine racine : app.<DOMAINE>, caisse.<DOMAINE>, stock.<DOMAINE>
DOMAINE=
# [PROD] email pour Let's Encrypt (alertes d'expiration de certificat)
ACME_EMAIL=
# Nombre de jours de sauvegardes conservées dans ./backups
BACKUP_RETENTION_DAYS=14

# ── Ports hôte en local (changer si 80/81/82 sont déjà pris ; ignorés en prod) ──
HTTP_BACKOFFICE=80
HTTP_CAISSE=81
HTTP_STOCK=82
